# ============================================================================
# eduSmart - Environment variables reference
# ============================================================================
# These are read as OS environment variables by the Spring Boot backend
# (see backend/src/main/resources/application.yml for the defaults used
# when a variable is not set). If you're running the backend from an IDE,
# set these in your run configuration; if running from a terminal, export
# them before running mvnw, or just rely on the sensible localhost defaults
# below for local development.
#
# The frontend has its own separate env file: frontend/.env.example
# ============================================================================

# --- PostgreSQL connection (used by the backend) ---------------------------
DB_URL=jdbc:postgresql://localhost:5432/edusmart
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- CORS: must match the URL the React dev server runs on -----------------
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Docker-based Java code execution ---------------------------------------
# Image used to compile/run submitted Java code. openjdk:21-jdk-slim works
# out of the box after `docker pull openjdk:21-jdk-slim`. See
# backend/docker/java-runner/Dockerfile for an optional hardened alternative.
DOCKER_JAVA_IMAGE=openjdk:21-jdk-slim
CODE_RUN_TIMEOUT_SECONDS=5
CODE_OVERALL_TIMEOUT_SECONDS=20
